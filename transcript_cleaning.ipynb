# Load raw transcript
with open("../transcripts/Speaker_0025_00001_transcript.txt", "r") as f:
    raw_text = f.read()

# Basic cleaning
cleaned_text = raw_text.replace("\n", " ").strip()

# Save cleaned transcript
with open("../transcripts/Speaker_0025_00001_cleaned.txt", "w") as f:
    f.write(cleaned_text)

print("Transcript cleaned and saved successfully")
